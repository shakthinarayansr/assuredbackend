# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Database (TRD §3) -------------------------------------------------------
DATABASE_URL=postgresql://assuredgig:assuredgig@localhost:5432/assuredgig?schema=public

# --- Redis / BullMQ ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth (TRD §7) -----------------------------------------------------------
# Access token short-lived; refresh rotating and device-bound.
JWT_ACCESS_SECRET=change-me-in-every-environment
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=30d
OTP_PEPPER=change-me-as-well

# --- Object storage: Cloudflare R2 (TRD §9) ----------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=assuredgig-media
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_PRESIGN_TTL_SECONDS=300

# --- Messaging: MSG91 (TRD §11) ---------------------------------------------
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_WEBHOOK_SECRET=

# --- Push: FCM ---------------------------------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Errors ------------------------------------------------------------------
SENTRY_DSN=

# NOTE: operational thresholds (geofence radius, skew tolerance, grace windows,
# score weights) do NOT belong here. They live in the Config table — TRD §12.
